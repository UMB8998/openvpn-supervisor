[Unit]
Description=Restart the OpenVPN client when the tunnel goes stale
After=network-online.target
Wants=network-online.target

[Service]
# Set these, or override them with: systemctl edit openvpn-supervisor
Environment="ip=10.25.0.5"
Environment="service=CHANGE_ME"
Environment="remoteip="
ExecStart=/usr/bin/python3 /opt/openvpn-supervisor/openvpn_supervisor.py --ip ${ip} --service ${service} --remoteip ${remoteip}
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
